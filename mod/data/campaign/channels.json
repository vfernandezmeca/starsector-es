{
	"defaultChannels":[
		"news",
		"hegemony_public",
		"tritachyon_public",
		"player_intel_always",
		"local_comm",
		"secure_comm",
	],
	
	# messages sent on these channels will need to pass the same intel check as intercepts of comms
	# on other channels, but won't show an "intercepted by comm sniffer" note,
	# as conceptually they're an intel report based on data gleaned by comm sniffer,
	# rather than an actual intercept.
	"playerIntelChannels":[
		"player_intel",
	],
	
	"local_comm":{
		"name":"$sender",
		"logo":"graphics/icons/intel/comms64.png",
		"icon":"graphics/icons/intel/comms64.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_comm_local",
		"type":"Comunicaciones locales",
		"shortType":"Comunicaciones",
	},
	"secure_comm":{
		"name":"$sender",
		"logo":"graphics/icons/intel/comms_secure64.png",
		"icon":"graphics/icons/intel/comms_secure64.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_comm_secure",
		"type":"Canal de comunicaciones seguro",
		"shortType":"Comunicaciones",
	},
	"player_intel_always":{
		"name":"Analisis y proyecciones",
		"subChannelOf":"player_intel",
		"logo":"graphics/icons/intel/player.png",
		"icon":"graphics/icons/intel/player.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_intel_assessment",
		"type":"Evaluacion de inteligencia",
		"shortType":"Inteligencia",
	},
	"player_intel":{
		"name":"Analisis y proyecciones",
		"logo":"graphics/icons/intel/player.png",
		"icon":"graphics/icons/intel/player.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_intel_assessment",
		"type":"Evaluacion de inteligencia",
		"shortType":"Inteligencia",
	},
	"player_comm_sniffer":{
		"name":"Programa de interceptacion de comunicaciones",
		"logo":"graphics/icons/intel/player_comm_sniffer.png",
		"icon":"graphics/icons/intel/player_comm_sniffer.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_sniffer",
		"type":"Canal de datos de comunicaciones",
		"shortType":"Datos",
	},
	"news":{
		"name":"Boletin local",
		"logo":"graphics/icons/intel/news64.png",
		"icon":"graphics/icons/intel/news64.png",
		"image":"graphics/factions/neutral_traders.png",
